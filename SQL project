SELECT industry_group, COUNT(DISTINCT company) AS num_companies, SUM(carbon_footprint_pcf) AS total_industry_footprint
FROM public.product_emissions
	WHERE product_emissions.year = 2017
GROUP BY industry_group
ORDER BY total_industry_footprint DESC;


